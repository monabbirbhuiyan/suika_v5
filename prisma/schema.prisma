generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  bio                     String?
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  notificationPreferences NotificationPreferences?
  privacyPreferences      PrivacyPreferences?
  problemSpaces           ProblemSpace[]
  sessions                Session[]
  subscription            Subscription?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model NotificationPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  emailJournalReminder      Boolean  @default(true)
  emailWeeklySummary        Boolean  @default(true)
  emailProblemSpaceActivity Boolean  @default(false)
  emailProductUpdates       Boolean  @default(true)
  emailSecurityAlerts       Boolean  @default(true)
  inAppJournalPrompt        Boolean  @default(true)
  inAppProblemProgress      Boolean  @default(true)
  inAppMilestones           Boolean  @default(true)
  digestFrequency           String   @default("weekly")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PrivacyPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  profileSearchable         Boolean  @default(false)
  allowUsageAnalytics       Boolean  @default(false)
  allowAiTraining           Boolean  @default(false)
  allowPersonalizedInsights Boolean  @default(true)
  dataRetentionPolicy       String   @default("forever")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_preferences")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             PlanTier  @default(FREE)
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model ProblemSpace {
  id                     String            @id @default(cuid())
  userId                 String
  title                  String
  description            String?
  progress               Int               @default(0)
  sentiment              Sentiment         @default(NEUTRAL)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  aiConclusionCache      Json?
  aiConnectionsCache     Json?
  aiConnectionsSignature String?
  aiConclusionSignature  Json?
  fragments              Fragment[]
  connections            GraphConnection[]
  graphNodes             GraphNode[]
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("problem_spaces")
}

model Fragment {
  id             String       @id @default(cuid())
  problemSpaceId String
  nodeId         String
  content        String
  type           FragmentType @default(QUESTION)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  node           GraphNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  problemSpace   ProblemSpace @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)

  @@index([problemSpaceId])
  @@index([nodeId])
  @@map("fragments")
}

model GraphNode {
  id             String         @id @default(cuid())
  problemSpaceId String
  title          String
  headerColor    String         @default("sage")
  posX           Float          @default(0)
  posY           Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  fragments      Fragment[]
  pins           GraphNodePin[]
  problemSpace   ProblemSpace   @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)

  @@index([problemSpaceId])
  @@map("graph_nodes")
}

model GraphNodePin {
  id             String            @id @default(cuid())
  nodeId         String
  label          String
  direction      PinDirection
  sortOrder      Int               @default(0)
  outConnections GraphConnection[] @relation("FromPin")
  inConnections  GraphConnection[] @relation("ToPin")
  node           GraphNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("graph_node_pins")
}

model GraphConnection {
  id             String       @id @default(cuid())
  problemSpaceId String
  fromPinId      String
  toPinId        String
  createdAt      DateTime     @default(now())
  fromPin        GraphNodePin @relation("FromPin", fields: [fromPinId], references: [id], onDelete: Cascade)
  problemSpace   ProblemSpace @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)
  toPin          GraphNodePin @relation("ToPin", fields: [toPinId], references: [id], onDelete: Cascade)

  @@unique([fromPinId, toPinId])
  @@index([problemSpaceId])
  @@map("graph_connections")
}

model CanLIIDataset {
  id           String             @id @default(cuid())
  canliiId     String             @unique
  title        String
  citation     String?
  court        String?
  jurisdiction String?
  documentType CanLIIDocumentType
  decisionDate DateTime?
  url          String?
  content      String?
  metadata     Json?
  contentHash  String?
  indexedAt    DateTime           @default(now())
  lastSyncedAt DateTime?
  syncStatus   SyncStatus         @default(PENDING)
  syncError    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([jurisdiction])
  @@index([court])
  @@index([documentType])
  @@index([decisionDate])
  @@index([syncStatus])
  @@map("canlii_datasets")
}

model CanLIISyncLog {
  id           String     @id @default(cuid())
  status       SyncStatus @default(PENDING)
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  totalFetched Int        @default(0)
  totalSaved   Int        @default(0)
  totalFailed  Int        @default(0)
  errorMessage String?
  triggeredBy  String?

  @@index([status])
  @@index([startedAt])
  @@map("canlii_sync_logs")
}

enum PlanTier {
  FREE
  THOUGHT_PARTNER
  LIFE_ARCHITECT
}

enum Sentiment {
  CLARIFYING
  CONTRADICTING
  RESOLVING
  NEUTRAL
}

enum FragmentType {
  QUESTION
  IDEA
  OBSERVATION
  CONSTRAINS
  CONCLUSION
}

enum PinDirection {
  INPUT
  OUTPUT
}

enum CanLIIDocumentType {
  CASE_LAW
  LEGISLATION
  REGULATION
  TRIBUNAL_DECISION
  SECONDARY_SOURCE
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model AnalysisChatMessage {
  id             String   @id @default(cuid())
  problemSpaceId String
  userId         String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([problemSpaceId, userId])
  @@index([createdAt])
  @@map("analysis_chat_messages")
}
