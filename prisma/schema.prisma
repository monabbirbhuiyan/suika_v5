// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String         @id
  name          String
  email         String
  bio           String?
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscription  Subscription?
  problemSpaces ProblemSpace[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Subscriptions & Plans ───────────────────────────────────────────────────

enum PlanTier {
  FREE
  THOUGHT_PARTNER
  LIFE_ARCHITECT
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             PlanTier  @default(FREE)
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Problem Spaces ──────────────────────────────────────────────────────────

enum Sentiment {
  CLARIFYING
  CONTRADICTING
  RESOLVING
  NEUTRAL
}

model ProblemSpace {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  progress    Int       @default(0) // 0–100 clarity percentage
  sentiment   Sentiment @default(NEUTRAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragments   Fragment[]
  graphNodes  GraphNode[]
  connections GraphConnection[]
  suggestions AiSuggestion[]

  @@index([userId])
  @@map("problem_spaces")
}

// ─── Fragments ───────────────────────────────────────────────────────────────

enum FragmentType {
  QUESTION
  IDEA
  OBSERVATION
  CONSTRAINS
  CONCLUSION
}

model Fragment {
  id             String       @id @default(cuid())
  problemSpaceId String
  nodeId         String
  content        String
  type           FragmentType @default(QUESTION)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  problemSpace ProblemSpace @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)
  node         GraphNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([problemSpaceId])
  @@index([nodeId])
  @@map("fragments")
}

// ─── Clarity Graph ───────────────────────────────────────────────────────────

model GraphNode {
  id             String   @id @default(cuid())
  problemSpaceId String
  title          String
  headerColor    String   @default("sage") // sage | soft-blue | gentle-coral | mint
  posX           Float    @default(0)
  posY           Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problemSpace ProblemSpace   @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)
  fragments    Fragment[]
  pins         GraphNodePin[]

  @@index([problemSpaceId])
  @@map("graph_nodes")
}

enum PinDirection {
  INPUT
  OUTPUT
}

model GraphNodePin {
  id        String       @id @default(cuid())
  nodeId    String
  label     String
  direction PinDirection
  sortOrder Int          @default(0)

  node           GraphNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  outConnections GraphConnection[] @relation("FromPin")
  inConnections  GraphConnection[] @relation("ToPin")

  @@index([nodeId])
  @@map("graph_node_pins")
}

model GraphConnection {
  id             String   @id @default(cuid())
  problemSpaceId String
  fromPinId      String
  toPinId        String
  createdAt      DateTime @default(now())

  problemSpace ProblemSpace @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)
  fromPin      GraphNodePin @relation("FromPin", fields: [fromPinId], references: [id], onDelete: Cascade)
  toPin        GraphNodePin @relation("ToPin", fields: [toPinId], references: [id], onDelete: Cascade)

  @@unique([fromPinId, toPinId])
  @@index([problemSpaceId])
  @@map("graph_connections")
}

// ─── AI Weaving Suggestions ─────────────────────────────────────────────────

enum SuggestionStrength {
  STRONG
  MEDIUM
  GENTLE
}

model AiSuggestion {
  id             String             @id @default(cuid())
  problemSpaceId String
  fromTitle      String
  toTitle        String
  reason         String
  strength       SuggestionStrength @default(MEDIUM)
  accepted       Boolean            @default(false)
  dismissedAt    DateTime?
  createdAt      DateTime           @default(now())

  problemSpace ProblemSpace @relation(fields: [problemSpaceId], references: [id], onDelete: Cascade)

  @@index([problemSpaceId])
  @@map("ai_suggestions")
}
